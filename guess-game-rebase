import random

# Программа загадывает число от 1 до 100
secret_number = random.randint(1, 100)
attempts = 0
max_attempts = 5

print("Я загадал число от 1 до 100. Попробуй угадать!")
print(f"У тебя {max_attempts} попыток!")

while attempts < max_attempts:
    try:
        guess = int(input("Введите число: "))
        attempts += 1
        remaining = max_attempts - attempts
        
        if guess < secret_number:
            print(f"Мало! Осталось попыток: {remaining}")
        elif guess > secret_number:
            print(f"Много! Осталось попыток: {remaining}")
        else:
            print(f"Ура! Ты угадал число {secret_number} за {attempts} попыток!")
            break
    except ValueError:
        print("Пожалуйста, введи целое число.")
else:
    print(f"Попытки кончились! Было загадано {secret_number}")
